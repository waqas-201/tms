generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// Better Auth Core Models (lowercase mapped table names)
// -------------------------------------------------------------

model User {
  id            String                @id @default(cuid())
  name          String
  email         String                @unique
  emailVerified Boolean               @default(false)
  image         String?
  role          String                @default("user") // "admin" | "hakim" | "user"
  phone         String?
  city          String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  consultations ConsultationRequest[]
  hijamaBookings HijamaBooking[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// -------------------------------------------------------------
// Apothecary & E-Commerce Models
// -------------------------------------------------------------

model Category {
  id          String    @id
  slug        String    @unique
  name        String
  urduName    String
  description String
  heroImage   String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  urduName           String
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryLabel      String
  categoryUrdu       String
  shortDescription   String
  fullDescription    String
  traditionalPurpose String
  benefits           String // Stored as JSON string
  ingredients        String // Stored as JSON string [{ name, urdu, role }]
  howToUse           String
  dosage             String
  hakimAdvice        String
  warnings           String? // Stored as JSON string
  price              Float
  originalPrice      Float?
  discountPercentage Int?
  image              String
  inStock            Boolean       @default(true)
  featured           Boolean       @default(false)
  rating             Float         @default(5.0)
  reviewCount        Int           @default(0)
  badge              String?
  mizaj              String? // Temperament (e.g. Barid Ratab, Haar Yabis, Mo'tadil)
  sizes              ProductSize[]
  orderItems         OrderItem[]
  reviews            Review[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Unit {
  id        String        @id @default(cuid())
  code      String        @unique // "g", "ml", "jar", "bottle", "pcs", "tola"
  name      String                // "Gram", "Millilitre", "Jar"
  kind      String                // "WEIGHT" | "VOLUME" | "COUNT" | "PACK"
  isActive  Boolean       @default(true)
  sizes     ProductSize[]
}

model StockMovement {
  id            String      @id @default(cuid())
  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  type          String      // RECEIVE | ADJUST | RESERVE | RELEASE | SALE
  quantity      Int         // signed: + receive, - sale
  onHandAfter   Int
  reservedAfter Int
  reason        String?
  batchNumber   String?
  expiryDate    DateTime?
  unitCost      Float?
  orderId       String?
  createdById   String?
  createdAt     DateTime    @default(now())
}

model ProductSize {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String              // e.g. "Small Jar", "500ml Bottle"
  weight             String              // e.g. "250g", "800ml"
  price              Float
  originalPrice      Float?
  costPrice          Float?              // Purchase/Manufacturing cost per unit
  batchNumber        String?
  expiryDate         DateTime?
  unitId             String?
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quantityValue      Float?              // e.g. 500 for 500g
  sku                String?             @unique
  stockOnHand        Int                 @default(0)
  stockReserved      Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  movements          StockMovement[]
  orderItems         OrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Order {
  id            String          @id @default(cuid())
  orderNumber   String          @unique // e.g. TMS-2026-1001
  customerName  String
  phone         String
  email         String?
  city          String
  address       String
  deliveryNotes String?
  paymentMethod String          @default("COD") // "COD" | "WHATSAPP" | "ONLINE" | "CASH" | "BANK"
  paymentStatus String          @default("PENDING") // "PENDING" | "PARTIAL" | "PAID" | "REFUNDED"
  orderStatus   String          @default("PENDING") // "PENDING" | "CONFIRMED" | "DISPATCHED" | "DELIVERED" | "CANCELLED"
  subtotal      Float
  shippingFee   Float           @default(0)
  total         Float
  paidAmount    Float           @default(0)
  dueAmount     Float           @default(0)
  trackingNote  String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      PaymentRecord[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSizeId   String?
  productSize     ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productName     String
  productUrduName String?
  sizeName        String
  sizeWeight      String
  price           Float
  quantity        Int
  total           Float
  productImage    String?
  stockState      String       @default("NONE") // NONE | RESERVED | COMMITTED | RELEASED
  createdAt       DateTime     @default(now())
}

// -------------------------------------------------------------
// Clinical Consultation & Patient Inquiries
// -------------------------------------------------------------

model ConsultationRequest {
  id                  String   @id @default(cuid())
  ticketNumber        String   @unique // e.g. CON-2026-8921
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultationType    String   @default("ONLINE") // "ONLINE" | "IN_PERSON"
  appointmentDate     String?  // "YYYY-MM-DD" e.g. "2026-10-05"
  appointmentSlot     String?  // "10:00 AM - 11:00 AM"
  patientName         String?
  patientPhone        String?
  patientEmail        String?
  primarySymptoms     String?  // Health concern or brief notes
  reportUrl           String?
  reportName          String?
  reportSize          String?
  status              String   @default("NEW") // "NEW" | "CONFIRMED" | "RESCHEDULED" | "PRESCRIBED" | "COMPLETED" | "CANCELLED"
  hakimNotes          String?
  prescribedTreatment String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([appointmentDate, appointmentSlot])
  @@index([status])
}

model ClinicSchedule {
  id                String   @id @default(cuid())
  dayOfWeek         Int      @unique // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayName           String   // "Sunday", "Monday", "Tuesday", etc.
  isOpen            Boolean  @default(true)
  openTime          String   @default("10:00") // "10:00" in 24h format
  closeTime         String   @default("21:00") // "21:00" in 24h format
  slotDurationMins  Int      @default(60) // 60 minutes
  maxSlotsPerWindow Int      @default(1) // 1 patient per slot
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("clinic_schedule")
}

model ClinicHoliday {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  reason    String   // e.g. "Eid-ul-Fitr", "Clinic Maintenance"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clinic_holiday")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  city      String?
  subject   String
  message   String
  status    String   @default("UNREAD") // "UNREAD" | "READ" | "RESPONDED"
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int      @default(5)
  comment   String
  city      String?
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// Payments & Receipts
// -------------------------------------------------------------

model PaymentRecord {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  amount        Float
  paymentMethod String   @default("COD") // "COD" | "CASH" | "BANK" | "JAZZCASH" | "EASYPAISA" | "ONLINE"
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// Hijama (Islamic Wet Cupping) Models
// -------------------------------------------------------------

model HijamaBooking {
  id                String   @id @default(cuid())
  ticketNumber      String   @unique // e.g. "HIJ-2026-1042"
  fullName          String
  phone             String
  email             String?
  age               Int
  gender            String   // "MALE" | "FEMALE"
  appointmentDate   String   // "YYYY-MM-DD"
  appointmentSlot   String   // e.g. "10:00 AM - 10:45 AM"
  hijriDate         String?  // e.g. "17 Rajab 1447"
  isSunnahDay       Boolean  @default(false)
  cuppingReason     String?  // Pain relief, migraine, general detox, sunnah revival, etc.
  contraindications String?  // Stored JSON string of safety screening answers (blood thinners, pregnancy, etc.)
  status            String   @default("CONFIRMED") // "CONFIRMED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  feeAmount         Float    @default(2500) // PKR
  paymentStatus     String   @default("UNPAID") // "UNPAID" | "PAID_AT_CLINIC"
  adminNotes        String?
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([appointmentDate, status])
  @@index([gender, appointmentDate])
  @@map("hijama_booking")
}

model HijamaScheduleConfig {
  id                 String   @id @default(cuid())
  dayOfWeek          Int      @unique // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayName            String   // "Sunday", etc.
  isOpen             Boolean  @default(true)
  openTime           String   @default("10:00")
  closeTime          String   @default("21:00")
  slotDurationMins   Int      @default(45)
  maxMaleCapacity    Int      @default(2) // 2 male beds/practitioner capacity
  maxFemaleCapacity  Int      @default(2) // 2 female beds/practitioner capacity
  customSlots        String?  // JSON stringified array of custom slots [{ slot, startTime, endTime, disabled }]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("hijama_schedule_config")
}

model HijamaSetting {
  id                   String   @id @default("default")
  moonSightingOffset   Int      @default(0) // -2 to +2 days for Pakistan Ruet-e-Hilal adjustment
  sunnahMaleCapacity   Int      @default(4) // Boosted capacity on Sunnah days
  sunnahFemaleCapacity Int      @default(4)
  standardFee          Float    @default(2500) // PKR standard cupping fee
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("hijama_setting")
}

model HijamaDateOverride {
  id                 String   @id @default(cuid())
  date               String   @unique // "YYYY-MM-DD"
  isClosed           Boolean  @default(false)
  openTime           String?  // optional override open time
  closeTime          String?  // optional override close time
  slotDurationMins   Int?     // optional override slot duration in minutes
  maxMaleCapacity    Int?     // override capacity
  maxFemaleCapacity  Int?
  customSlots        String?  // JSON stringified array of custom slots [{ slot, startTime, endTime, disabled }]
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("hijama_date_override")
}


