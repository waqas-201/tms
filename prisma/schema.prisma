generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// Better Auth Core Models (lowercase mapped table names)
// -------------------------------------------------------------

model User {
  id            String                @id @default(cuid())
  name          String
  email         String                @unique
  emailVerified Boolean               @default(false)
  image         String?
  role          String                @default("user") // "admin" | "hakim" | "user"
  phone         String?
  city          String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  consultations ConsultationRequest[]
  customerLedgers CustomerLedgerEntry[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// -------------------------------------------------------------
// Apothecary & E-Commerce Models
// -------------------------------------------------------------

model Category {
  id          String    @id
  slug        String    @unique
  name        String
  urduName    String
  description String
  heroImage   String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  urduName           String
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryLabel      String
  categoryUrdu       String
  shortDescription   String
  fullDescription    String
  traditionalPurpose String
  benefits           String // Stored as JSON string
  ingredients        String // Stored as JSON string [{ name, urdu, role }]
  howToUse           String
  dosage             String
  hakimAdvice        String
  warnings           String? // Stored as JSON string
  price              Float
  originalPrice      Float?
  discountPercentage Int?
  image              String
  inStock            Boolean       @default(true)
  featured           Boolean       @default(false)
  rating             Float         @default(5.0)
  reviewCount        Int           @default(0)
  badge              String?
  mizaj              String? // Temperament (e.g. Barid Ratab, Haar Yabis, Mo'tadil)
  sizes              ProductSize[]
  orderItems         OrderItem[]
  reviews            Review[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Unit {
  id        String        @id @default(cuid())
  code      String        @unique // "g", "ml", "jar", "bottle", "pcs", "tola"
  name      String                // "Gram", "Millilitre", "Jar"
  kind      String                // "WEIGHT" | "VOLUME" | "COUNT" | "PACK"
  isActive  Boolean       @default(true)
  sizes     ProductSize[]
}

model StockMovement {
  id            String      @id @default(cuid())
  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  type          String      // RECEIVE | ADJUST | RESERVE | RELEASE | SALE
  quantity      Int         // signed: + receive, - sale
  onHandAfter   Int
  reservedAfter Int
  reason        String?
  batchNumber   String?
  expiryDate    DateTime?
  unitCost      Float?
  orderId       String?
  createdById   String?
  createdAt     DateTime    @default(now())
}

model ProductSize {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String              // e.g. "Small Jar", "500ml Bottle"
  weight             String              // e.g. "250g", "800ml"
  price              Float
  originalPrice      Float?
  costPrice          Float?              // Purchase/Manufacturing cost per unit
  batchNumber        String?
  expiryDate         DateTime?
  unitId             String?
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quantityValue      Float?              // e.g. 500 for 500g
  sku                String?             @unique
  stockOnHand        Int                 @default(0)
  stockReserved      Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  movements          StockMovement[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Order {
  id            String          @id @default(cuid())
  orderNumber   String          @unique // e.g. TMS-2026-1001
  customerName  String
  phone         String
  email         String?
  city          String
  address       String
  deliveryNotes String?
  paymentMethod String          @default("COD") // "COD" | "WHATSAPP" | "ONLINE" | "CASH" | "BANK"
  paymentStatus String          @default("PENDING") // "PENDING" | "PARTIAL" | "PAID" | "REFUNDED"
  orderStatus   String          @default("PENDING") // "PENDING" | "CONFIRMED" | "DISPATCHED" | "DELIVERED" | "CANCELLED"
  subtotal      Float
  shippingFee   Float           @default(0)
  total         Float
  paidAmount    Float           @default(0)
  dueAmount     Float           @default(0)
  trackingNote  String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      PaymentRecord[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSizeId   String?
  productSize     ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productName     String
  productUrduName String?
  sizeName        String
  sizeWeight      String
  price           Float
  quantity        Int
  total           Float
  productImage    String?
  stockState      String       @default("NONE") // NONE | RESERVED | COMMITTED | RELEASED
  createdAt       DateTime     @default(now())
}

// -------------------------------------------------------------
// Classical Nuskhajaat & Compounded Herbal Formulas
// -------------------------------------------------------------

model Nuskha {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  urduTitle          String
  category           String             // e.g. "digestion", "joints-arthritis", "vitality", "respiratory", "brain-memory", "liver-detox"
  categoryLabel      String             // e.g. "Stomach & Digestion"
  shortDescription   String
  fullDescription    String
  traditionalPurpose String?
  mizaj              String?            // e.g. "Haar Yabis (Warm & Dry 2°)"
  dosageInstructions String
  howToPrepare       String?
  preparationType    String             @default("Safoof") // "Safoof" | "Majun" | "Joshanda" | "Roghan" | "Arq Mix"
  preparationFee     Float              @default(120.0)
  discountPercentage Int?               @default(0)
  image              String
  inStock            Boolean            @default(true)
  featured           Boolean            @default(false)
  rating             Float              @default(5.0)
  reviewCount        Int                @default(0)
  badge              String?
  benefits           String?            // Stored as JSON array string
  warnings           String?            // Stored as JSON array string
  hakimAdvice        String?
  ingredients        NuskhaIngredient[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model NuskhaIngredient {
  id              String   @id @default(cuid())
  nuskhaId        String
  nuskha          Nuskha   @relation(fields: [nuskhaId], references: [id], onDelete: Cascade)
  name            String
  urduName        String
  role            String?  // e.g. "Juz-e-Azam (Primary Herb)"
  unit            String   @default("grams") // "grams" | "tola" | "ml" | "pieces"
  defaultQuantity Float    @default(50.0)
  minQuantity     Float    @default(10.0)
  maxQuantity     Float    @default(500.0)
  step            Float    @default(5.0)
  pricePerUnit    Float    // Price in PKR per unit
  isOptional      Boolean  @default(false)
  notes           String?
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -------------------------------------------------------------
// Clinical Consultation & Patient Inquiries
// -------------------------------------------------------------

model ConsultationRequest {
  id                  String   @id @default(cuid())
  ticketNumber        String   @unique // e.g. CON-2026-8921
  fullName            String
  age                 Int
  gender              String // "Male" | "Female" | "Other"
  phone               String
  email               String?
  city                String
  primarySymptoms     String
  duration            String
  previousTreatments  String?
  currentMedications  String?
  digestiveState      String?
  sleepEnergyState    String?
  preferredContact    String   @default("WHATSAPP") // "WHATSAPP" | "PHONE" | "CLINIC"
  status              String   @default("NEW") // "NEW" | "IN_REVIEW" | "CONTACTED" | "PRESCRIBED" | "COMPLETED"
  hakimNotes          String?
  prescribedTreatment String?
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  city      String?
  subject   String
  message   String
  status    String   @default("UNREAD") // "UNREAD" | "READ" | "RESPONDED"
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int      @default(5)
  comment   String
  city      String?
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// Accounts, Payments, Vendors, Purchases & Financial Ledgers
// -------------------------------------------------------------

model PaymentRecord {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  amount        Float
  paymentMethod String   @default("COD") // "COD" | "CASH" | "BANK" | "JAZZCASH" | "EASYPAISA" | "ONLINE"
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
}

model Vendor {
  id             String              @id @default(cuid())
  name           String
  company        String?
  phone          String
  email          String?
  city           String?
  address        String?
  category       String?             // e.g. "Raw Herbs", "Packaging Jars", "Oils & Extracts", "General Supplies"
  paymentTerms   String?             // e.g. "Net 15", "Net 30", "Cash on Delivery", "Advance"
  currentBalance Float               @default(0) // positive = amount we owe vendor (payable)
  totalPurchased Float               @default(0)
  totalPaid      Float               @default(0)
  purchases      PurchaseOrder[]
  payments       VendorPayment[]
  ledgers        VendorLedgerEntry[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique // e.g. PO-2026-1001
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorInvoiceNo String?
  orderDate       DateTime            @default(now())
  dueDate         DateTime?
  status          String              @default("DRAFT") // "DRAFT" | "ORDERED" | "RECEIVED" | "CANCELLED"
  paymentStatus   String              @default("UNPAID") // "UNPAID" | "PARTIAL" | "PAID"
  subtotal        Float               @default(0)
  taxAmount       Float               @default(0)
  shippingCost    Float               @default(0)
  totalAmount     Float               @default(0)
  paidAmount      Float               @default(0)
  dueAmount       Float               @default(0)
  stockReceived   Boolean             @default(false)
  notes           String?
  items           PurchaseOrderItem[]
  payments        VendorPayment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productSizeId   String?
  productSize     ProductSize?   @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  itemName        String
  quantity        Int
  unitCost        Float
  totalCost       Float
  batchNumber     String?
  expiryDate      DateTime?
  createdAt       DateTime       @default(now())
}

model VendorPayment {
  id              String         @id @default(cuid())
  paymentNumber   String         @unique // e.g. VPAY-2026-1001
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  amount          Float
  paymentDate     DateTime       @default(now())
  paymentMethod   String         @default("BANK") // "BANK" | "CASH" | "CHEQUE" | "JAZZCASH" | "EASYPAISA" | "ONLINE"
  referenceNumber String?
  notes           String?
  recordedBy      String?
  createdAt       DateTime       @default(now())
}

model VendorLedgerEntry {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  type           String   // "PURCHASE_BILL" | "PAYMENT" | "RETURN" | "OPENING_BALANCE" | "ADJUSTMENT"
  reference      String?
  description    String
  debit          Float    @default(0) // payments made / deductions (reduces payable)
  credit         Float    @default(0) // bill amounts / purchases (increases payable)
  runningBalance Float    @default(0)
  createdAt      DateTime @default(now())
}

model CustomerLedgerEntry {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerPhone  String
  customerName   String
  date           DateTime @default(now())
  type           String   // "ORDER_INVOICE" | "PAYMENT_RECEIVED" | "REFUND" | "OPENING_BALANCE" | "ADJUSTMENT"
  reference      String?
  description    String
  debit          Float    @default(0) // order total / billed (increases receivable)
  credit         Float    @default(0) // payment collected / credited (decreases receivable)
  runningBalance Float    @default(0)
  createdAt      DateTime @default(now())
}

