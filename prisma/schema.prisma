generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// Better Auth Core Models (lowercase mapped table names)
// -------------------------------------------------------------

model User {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  emailVerified     Boolean               @default(false)
  image             String?
  role              String                @default("user") // "super_admin" | "admin" | "user"
  phone             String?
  city              String?
  address           String?
  latitude          Float?
  longitude         Float?
  isActive          Boolean               @default(true)
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          Session[]
  accounts          Account[]
  orders            Order[]
  consultations     ConsultationRequest[]
  hijamaBookings    HijamaBooking[]
  couponRedemptions CouponRedemption[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model BootstrapKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  consumedAt DateTime?
  redeemedBy String?

  @@map("bootstrap_key")
}

// -------------------------------------------------------------
// Apothecary & E-Commerce Models
// -------------------------------------------------------------

model Category {
  id          String    @id
  slug        String    @unique
  name        String
  urduName    String
  description String
  heroImage   String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  urduName           String
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryLabel      String
  categoryUrdu       String
  shortDescription   String
  fullDescription    String
  traditionalPurpose String
  benefits           String // Stored as JSON string
  ingredients        String // Stored as JSON string [{ name, urdu, role }]
  howToUse           String
  dosage             String
  hakimAdvice        String
  warnings           String? // Stored as JSON string
  price              Float
  originalPrice      Float?
  discountPercentage Int?
  image              String
  inStock            Boolean       @default(true)
  featured           Boolean       @default(false)
  rating             Float         @default(5.0)
  reviewCount        Int           @default(0)
  badge              String?
  mizaj              String? // Temperament (e.g. Barid Ratab, Haar Yabis, Mo'tadil)
  sizes              ProductSize[]
  orderItems         OrderItem[]
  reviews            Review[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Unit {
  id        String        @id @default(cuid())
  code      String        @unique // "g", "ml", "jar", "bottle", "pcs", "tola"
  name      String                // "Gram", "Millilitre", "Jar"
  kind      String                // "WEIGHT" | "VOLUME" | "COUNT" | "PACK"
  isActive  Boolean       @default(true)
  sizes     ProductSize[]
}

model StockMovement {
  id            String      @id @default(cuid())
  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  type          String      // RECEIVE | ADJUST | RESERVE | RELEASE | SALE
  quantity      Int         // signed: + receive, - sale
  onHandAfter   Int
  reservedAfter Int
  reason        String?
  batchNumber   String?
  expiryDate    DateTime?
  unitCost      Float?
  orderId       String?
  createdById   String?
  createdAt     DateTime    @default(now())
}

model ProductSize {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String              // e.g. "Small Jar", "500ml Bottle"
  weight             String              // e.g. "250g", "800ml"
  price              Float
  originalPrice      Float?
  costPrice          Float?              // Purchase/Manufacturing cost per unit
  batchNumber        String?
  expiryDate         DateTime?
  unitId             String?
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quantityValue      Float?              // e.g. 500 for 500g
  sku                String?             @unique
  stockOnHand        Int                 @default(0)
  stockReserved      Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  movements          StockMovement[]
  orderItems         OrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique // e.g. TMS-2026-1001
  customerName       String
  phone              String
  email              String?
  city               String
  address            String
  customerLatitude   Float?
  customerLongitude  Float?
  deliveryDistanceKm Float?
  deliveryFeeType    String          @default("FLAT") // "DYNAMIC" | "FLAT" | "FREE"
  deliveryNotes      String?
  paymentMethod      String          @default("COD") // "COD" | "WHATSAPP" | "ONLINE" | "CASH" | "BANK"
  paymentStatus      String          @default("PENDING") // "PENDING" | "PARTIAL" | "PAID" | "REFUNDED"
  orderStatus        String          @default("PENDING") // "PENDING" | "CONFIRMED" | "DISPATCHED" | "DELIVERED" | "CANCELLED"
  subtotal           Float
  shippingFee        Float           @default(0)
  discountAmount     Float           @default(0)
  total              Float
  paidAmount         Float           @default(0)
  dueAmount          Float           @default(0)
  trackingNote       String?
  couponId           String?
  coupon             Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           PaymentRecord[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSizeId   String?
  productSize     ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productName     String
  productUrduName String?
  sizeName        String
  sizeWeight      String
  price           Float
  quantity        Int
  total           Float
  productImage    String?
  stockState      String       @default("NONE") // NONE | RESERVED | COMMITTED | RELEASED
  createdAt       DateTime     @default(now())
}

// -------------------------------------------------------------
// Clinical Consultation & Patient Inquiries
// -------------------------------------------------------------

model ConsultationSetting {
  id          String   @id @default("default")
  standardFee Float    @default(1500) // PKR standard consultation fee
  isFeeActive Boolean  @default(true) // Whether consultations have a charge or are complimentary
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("consultation_setting")
}

model ConsultationRequest {
  id                  String   @id @default(cuid())
  ticketNumber        String   @unique // e.g. CON-2026-8921
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  consultationType    String   @default("ONLINE") // "ONLINE" | "IN_PERSON"
  appointmentDate     String?  // "YYYY-MM-DD" e.g. "2026-10-05"
  appointmentSlot     String?  // "10:00 AM - 11:00 AM"
  patientName         String?
  patientPhone        String?
  patientEmail        String?
  primarySymptoms     String?  // Health concern or brief notes
  reportUrl           String?
  reportName          String?
  reportSize          String?
  status              String   @default("NEW") // "NEW" | "CONFIRMED" | "RESCHEDULED" | "PRESCRIBED" | "COMPLETED" | "CANCELLED"
  feeAmount           Float    @default(0)
  discountAmount      Float    @default(0)
  paymentStatus       String   @default("UNPAID") // "UNPAID" | "PAID_AT_CLINIC" | "FREE_VOUCHER" | "PAID_ONLINE"
  couponId            String?
  coupon              Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?
  hakimNotes          String?
  prescribedTreatment String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([appointmentDate, appointmentSlot])
  @@index([status])
}

model ClinicSchedule {
  id                String   @id @default(cuid())
  dayOfWeek         Int      @unique // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayName           String   // "Sunday", "Monday", "Tuesday", etc.
  isOpen            Boolean  @default(true)
  openTime          String   @default("10:00") // "10:00" in 24h format
  closeTime         String   @default("21:00") // "21:00" in 24h format
  slotDurationMins  Int      @default(60) // 60 minutes
  maxSlotsPerWindow Int      @default(1) // 1 patient per slot
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("clinic_schedule")
}

model ClinicHoliday {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  reason    String   // e.g. "Eid-ul-Fitr", "Clinic Maintenance"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clinic_holiday")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  city      String?
  subject   String
  message   String
  status    String   @default("UNREAD") // "UNREAD" | "READ" | "RESPONDED"
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int      @default(5)
  comment   String
  city      String?
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// Payments & Receipts
// -------------------------------------------------------------

model PaymentRecord {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  amount        Float
  paymentMethod String   @default("COD") // "COD" | "CASH" | "BANK" | "JAZZCASH" | "EASYPAISA" | "ONLINE"
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
}

// -------------------------------------------------------------
// Hijama (Islamic Wet Cupping) Models
// -------------------------------------------------------------

model HijamaBooking {
  id                String   @id @default(cuid())
  ticketNumber      String   @unique // e.g. "HIJ-2026-1042"
  fullName          String
  phone             String
  email             String?
  age               Int
  gender            String   // "MALE" | "FEMALE"
  appointmentDate   String   // "YYYY-MM-DD"
  appointmentSlot   String   // e.g. "10:00 AM - 10:45 AM"
  hijriDate         String?  // e.g. "17 Rajab 1447"
  isSunnahDay       Boolean  @default(false)
  cuppingReason     String?  // Pain relief, migraine, general detox, sunnah revival, etc.
  contraindications String?  // Stored JSON string of safety screening answers (blood thinners, pregnancy, etc.)
  status            String   @default("PENDING") // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  feeAmount         Float    @default(2500) // PKR final payable
  originalFee       Float    @default(2500) // PKR standard base fee
  discountAmount    Float    @default(0)    // PKR coupon discount applied
  paymentStatus     String   @default("UNPAID") // "UNPAID" | "PAID_AT_CLINIC"
  couponId          String?
  coupon            Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode        String?
  adminNotes        String?
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([appointmentDate, status])
  @@index([gender, appointmentDate])
  @@map("hijama_booking")
}

model HijamaScheduleConfig {
  id                 String   @id @default(cuid())
  dayOfWeek          Int      @unique // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayName            String   // "Sunday", etc.
  isOpen             Boolean  @default(true)
  openTime           String   @default("10:00")
  closeTime          String   @default("21:00")
  slotDurationMins   Int      @default(45)
  maxMaleCapacity    Int      @default(2) // 2 male beds/practitioner capacity
  maxFemaleCapacity  Int      @default(2) // 2 female beds/practitioner capacity
  customSlots        String?  // JSON stringified array of custom slots [{ slot, startTime, endTime, disabled }]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("hijama_schedule_config")
}

model HijamaSetting {
  id                   String   @id @default("default")
  moonSightingOffset   Int      @default(-1) // -2 to +2 days for Pakistan Ruet-e-Hilal adjustment
  sunnahMaleCapacity   Int      @default(4) // Boosted capacity on Sunnah days
  sunnahFemaleCapacity Int      @default(4)
  standardFee          Float    @default(2500) // PKR standard cupping fee
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("hijama_setting")
}

// -------------------------------------------------------------
// Delivery & Store Location Settings
// -------------------------------------------------------------

model DeliverySetting {
  id                        String   @id @default("default")
  storeName                 String   @default("Matab Tameer-e-sehat")
  storeAddress              String   @default("Plot no L, 41 Korangi Crossing Rd, K.D.A Allah Wala Town Sector 31 B Korangi, Karachi, Pakistan")
  storeLatitude             Float    @default(24.8291)
  storeLongitude            Float    @default(67.1147)
  pricePerKm                Float    @default(25.0)
  baseDeliveryFee           Float    @default(100.0)
  minDeliveryFee            Float    @default(150.0)
  maxLocalRadiusKm          Float    @default(50.0)
  flatCourierFee            Float    @default(200.0)
  freeShippingThreshold     Float    @default(2000.0)
  isDynamicDeliveryEnabled  Boolean  @default(true)
  googleMapsApiKey          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("delivery_setting")
}

// -------------------------------------------------------------
// Marketing & Coupons Engine
// -------------------------------------------------------------

model Coupon {
  id                  String             @id @default(cuid())
  code                String             @unique // Stored UPPERCASE, e.g. "SEHAT20"
  description         String
  scope               String             @default("PRODUCTS") // "PRODUCTS" | "HIJAMA" | "CONSULTATION" | "ALL" | "CATEGORY"
  discountType        String             @default("PERCENTAGE") // "PERCENTAGE" | "FIXED" | "FREE_SHIPPING" | "FREE_SERVICE"
  discountValue       Float              // e.g. 15 for 15%, 500 for 500 PKR
  minSubtotal         Float?             // Minimum order or booking subtotal required
  maxDiscountCap      Float?             // Max PKR cap for percentage discounts
  targetCategoryId    String?            // If scope is CATEGORY, target category slug or id
  targetProductIds    String?            // JSON string array of specific product IDs
  startDate           DateTime?
  endDate             DateTime?
  usageLimit          Int?               // Total allowed redemptions across all users
  usageCount          Int                @default(0)
  perUserLimit        Int                @default(1) // Allowed redemptions per user / phone number
  isActive            Boolean            @default(true)
  isFlashSale         Boolean            @default(false)
  flashSaleBannerText String?            // e.g. "⚡ Flash Offer: 20% Off All Murabba Preserves!"
  flashSaleBadge      String?            // e.g. "FLASH 20% OFF"
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  redemptions         CouponRedemption[]
  orders              Order[]
  hijamaBookings      HijamaBooking[]
  consultations       ConsultationRequest[]

  @@map("coupon")
}

model CouponRedemption {
  id              String               @id @default(cuid())
  couponId        String
  coupon          Coupon               @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone           String?              // Normalized phone / WhatsApp
  orderId         String?
  hijamaBookingId String?
  consultationId  String?
  discountAmount  Float
  orderTotal      Float?
  redeemedAt      DateTime             @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([phone])
  @@map("coupon_redemption")
}

// -------------------------------------------------------------
// Admin In-App Notifications
// -------------------------------------------------------------

model AdminNotification {
  id        String    @id @default(cuid())
  type      String // "ORDER" | "CONSULTATION" | "HIJAMA" | "INQUIRY"
  title     String
  message   String
  link      String? // Deep link into the admin dashboard
  entityId  String? // Related order / consultation / booking id
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@map("admin_notification")
}

model HijamaDateOverride {
  id                 String   @id @default(cuid())
  date               String   @unique // "YYYY-MM-DD"
  isClosed           Boolean  @default(false)
  openTime           String?  // optional override open time
  closeTime          String?  // optional override close time
  slotDurationMins   Int?     // optional override slot duration in minutes
  maxMaleCapacity    Int?     // override capacity
  maxFemaleCapacity  Int?
  customSlots        String?  // JSON stringified array of custom slots [{ slot, startTime, endTime, disabled }]
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("hijama_date_override")
}
