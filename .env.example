# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Database -------------------------------------------------------------
# Postgres connection string (Neon/Supabase/Vercel Marketplace, etc.)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=verify-full"

# --- Auth -----------------------------------------------------------------
# 32+ char random string: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Canonical origin of the app (no trailing slash required)
BETTER_AUTH_URL="https://www.tameeresehat.com"
NEXT_PUBLIC_APP_URL="https://www.tameeresehat.com"
DOMAIN="https://www.tameeresehat.com"

# --- Admin bootstrap ------------------------------------------------------
ADMIN_EMAIL="admin@tameeresehat.com"
ADMIN_INITIAL_PASSWORD=""

# --- Transactional email (Resend) -----------------------------------------
# Must be a key from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# IMPORTANT: must use a domain verified in Resend. The sandbox sender
# onboarding@resend.dev can only deliver to the Resend account owner's own
# address and returns a 403 for everyone else.
EMAIL_FROM="Tameer-e-Sehat <noreply@tameeresehat.com>"
# Optional. Only set once the domain can actually receive mail (MX record).
EMAIL_REPLY_TO=""
# Where admin/order/booking alerts are delivered. Defaults to ADMIN_EMAIL.
# Set this to an inbox a human actually reads.
ADMIN_NOTIFICATION_EMAIL=""
# Used by the resend-mcp server (docs/mcp-resend.md)
SENDER_EMAIL_ADDRESS="noreply@tameeresehat.com"

# --- Google Search Console MCP --------------------------------------------
# Path to your Google Cloud service account JSON key file (relative or absolute)
# Used by the google-search-console MCP server (docs/mcp-google-search-console.md)
GSC_SERVICE_ACCOUNT_KEY_PATH="./secrets/gsc-service-account.json"
# Primary site property URL in Google Search Console (e.g. "https://www.tameeresehat.com" or "sc-domain:tameeresehat.com")
GSC_SITE_URL="https://www.tameeresehat.com"

# --- Uploads --------------------------------------------------------------
UPLOADTHING_TOKEN=""
